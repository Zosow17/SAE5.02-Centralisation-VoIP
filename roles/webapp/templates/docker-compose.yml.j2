services:
  flask:
    build:
      context: .
      dockerfile: Dockerfile

    image: "{{ flask_image }}"
    container_name: "{{ flask_container_name }}"
    restart: unless-stopped

    ports:
      - "{{ flask_port }}:5000"

    environment:
      DB_HOST: "{{ mariadb_container_name }}"
      DB_NAME: "{{ mariadb_database }}"
      DB_USER: "{{ mariadb_user }}"
      DB_PASSWORD: "{{ vault_mariadb_user_password }}"

    networks:
      - centralis-net

networks:
  centralis-net:
    external: true
